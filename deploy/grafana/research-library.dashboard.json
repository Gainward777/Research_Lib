        {"expr": "histogram_quantile(0.95, sum by (tool, le) (rate(mcp_request_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\"}[5m])))", "legendFormat": "{{tool}} p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (tool, le) (rate(mcp_request_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\"}[5m])))", "legendFormat": "{{tool}} p99", "refId": "C"}
