        {"expr": "sum by (project) (increase(memento_context_publish_requests_total{service=~\"$service\",environment=~\"$environment\",project=~\"$project\",outcome=~\"validation_error|idempotency_conflict\"}[1h]))", "legendFormat": "publish {{project}}", "refId": "B"}
