{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (outcome) (rate(memento_context_search_requests_total{service=~\"$service\",environment=~\"$environment\",project=~\"$project\"}[5m]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "title": "Memento searches / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(memento_context_search_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",project=~\"$project\"}[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "Memento search p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "sum(rate(memento_context_search_requests_total{service=~\"$service\",environment=~\"$environment\",project=~\"$project\",outcome=\"empty\"}[5m])) / clamp_min(sum(rate(memento_context_search_requests_total{service=~\"$service\",environment=~\"$environment\",project=~\"$project\"}[5m])), 0.001)", "legendFormat": "empty ratio", "refId": "A"}],
      "title": "Empty search ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum by (kind, outcome) (rate(memento_context_publish_requests_total{service=~\"$service\",environment=~\"$environment\",project=~\"$project\"}[5m]))", "legendFormat": "{{kind}} / {{outcome}}", "refId": "A"}],
      "title": "Memento publications / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 5,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(memento_context_publish_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",project=~\"$project\"}[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "Memento publish p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 6,
      "targets": [{"expr": "sum(rate(memento_context_consulted_sources_sum{service=~\"$service\",environment=~\"$environment\",project=~\"$project\"}[15m])) / clamp_min(sum(rate(memento_context_consulted_sources_count{service=~\"$service\",environment=~\"$environment\",project=~\"$project\"}[15m])), 0.001)", "legendFormat": "sources / publication", "refId": "A"}],
      "title": "Average consulted sources",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 16},
      "id": 7,
      "targets": [{"expr": "library_pending_index_jobs{service=~\"$service\",environment=~\"$environment\"}", "refId": "A"}],
      "title": "Pending index jobs",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 16},
      "id": 8,
      "targets": [{"expr": "library_oldest_pending_index_age_seconds{service=~\"$service\",environment=~\"$environment\"}", "refId": "A"}],
      "title": "Oldest pending job",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 16},
      "id": 9,
      "targets": [{"expr": "sum by (outcome) (rate(library_retry_jobs_total{service=~\"$service\",environment=~\"$environment\"}[5m]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "title": "Index retries / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 16},
      "id": 10,
      "targets": [{"expr": "sum by (operation, outcome) (rate(gbrain_operation_requests_total{service=~\"$service\",environment=~\"$environment\"}[5m]))", "legendFormat": "{{operation}} / {{outcome}}", "refId": "A"}],
      "title": "GBrain operations / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 22},
      "id": 11,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (operation, le) (rate(gbrain_operation_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\"}[5m])))", "legendFormat": "{{operation}}", "refId": "A"}],
      "title": "GBrain p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 22},
      "id": 12,
      "targets": [{"expr": "sum by (tool, outcome) (rate(mcp_requests_total{service=~\"$service\",environment=~\"$environment\"}[5m]))", "legendFormat": "{{tool}} / {{outcome}}", "refId": "A"}],
      "title": "MCP tools / second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 22},
      "id": 13,
      "targets": [{"expr": "sum by (reason) (increase(mcp_auth_failures_total{service=~\"$service\",environment=~\"$environment\"}[1h]))", "legendFormat": "{{reason}}", "refId": "A"}],
      "title": "MCP auth failures (1h)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["research-library", "memento"],
  "templating": {
    "list": [
      {"name": "service", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values(memento_context_search_requests_total, service)", "current": {"text": "research-library", "value": "research-library"}, "includeAll": true, "allValue": ".*"},
      {"name": "environment", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values(memento_context_search_requests_total, environment)", "includeAll": true, "allValue": ".*"},
      {"name": "project", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values(memento_context_search_requests_total, project)", "includeAll": true, "allValue": ".*"}
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Research Library / Memento",
  "uid": "research-library-memento",
  "version": 1
}
